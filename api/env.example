SERVER_PORT=3333
SERVER_HOST=localhost
SERVER_ROOT_PATH=
SERVER_TRUST_FORWARDED_FOR=false

WEBAPP_URL=http://localhost:5555
# One deployment serving several hostnames (webapp at /, API under SERVER_ROOT_PATH):
# build webapp links from each request's Host and X-Forwarded-Proto instead of WEBAPP_URL.
# Only behind a proxy that routes exact hostnames: a forged Host would otherwise end up
# in emailed links. WEBAPP_ALLOWED_HOSTS (comma-separated host[:port]) refuses any other host.
WEBAPP_URL_FROM_REQUEST=false
WEBAPP_ALLOWED_HOSTS=

ENV=development

DATABASE_NAME=ferriskey
DATABASE_HOST=localhost
DATABASE_USER=ferriskey
DATABASE_PASSWORD=ferriskey

ADMIN_PASSWORD=admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5555

LOG_FILTER=info
LOG_JSON=false
